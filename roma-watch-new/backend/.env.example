PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
NODE_ENV=development

# هزینه ارسال درب منزل (تومان) - اختیاری، در صورت نبود از مقدار پیش‌فرض کد استفاده میشه
SHIPPING_STANDARD_COST=250000

# هزینه‌ی اضافه‌ی روش پرداخت نقدی (وصول توسط پیک، جدا از هزینه ارسال بالا) - اختیاری، پیش‌فرض صفره
COD_EXTRA_COST=0

# سرویس پیامک - یکی از دو گزینه رو پر کن، Adapter خودکار همونو انتخاب می‌کنه:
#   کاوه‌نگار: فقط SMS_API_KEY (و اختیاری SMS_OTP_TEMPLATE برای ارسال OTP با پترن)
#   ملی‌پیامک (یا مشابه): SMS_USERNAME + SMS_PASSWORD
# تا وقتی خالی باشن، پیامک‌ها فقط توی کنسول سرور لاگ میشن (حالت شبیه‌سازی).
SMS_API_KEY=
SMS_OTP_TEMPLATE=
SMS_USERNAME=
SMS_PASSWORD=
SMS_SENDER=

# شماره(های) مدیر فروشگاه - با همین شماره و از همون مسیر معمولی OTP وارد شو،
# به‌صورت خودکار دسترسی پنل مدیریت (admin.html) رو می‌گیری. چند شماره رو با
# کاما جدا کن.
ADMIN_PHONES=09911749536

# شماره‌ی صاحب فروشگاه - به محض ثبت هر سفارش جدید، یه پیامک اطلاع‌رسانی
# (کد سفارش، مبلغ، مشخصات مشتری) به همین شماره فرستاده میشه.
OWNER_PHONE=09911749536

# آدرس فرانت‌اند - هم برای ساختن لینک بازگشت از درگاه پرداخت لازمه، هم لیست
# مجاز CORS همینه (فقط همین دامنه اجازه‌ی صدا زدن API رو داره). برای چند
# دامنه (مثلاً هم www هم بدون www)، با کاما جدا کن.
FRONTEND_URL=http://localhost:5500

# درگاه پرداخت زرین‌پال - با پر شدن PAYMENT_MERCHANT_ID، خودکار روی حالت
# واقعی سوییچ می‌کنه. تا وقتی خالیه، در حالت Sandbox (شبیه‌سازی‌شده) کار می‌کنه.
PAYMENT_API_KEY=
PAYMENT_MERCHANT_ID=
